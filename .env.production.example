# =============================================================================
# PRODUCTION .env TEMPLATE — reference only, NOT a real credentials file.
# Copy this to `.env` on the production server and fill in every blank value
# by hand, directly on the server. Never commit the real production .env
# anywhere, never copy your local .env over it — several values below are
# REQUIRED to differ from local dev or you reopen security issues that were
# specifically fixed during the 2026-08-15 audit (see project memory /
# DEPLOY.md for details).
# =============================================================================

# --- App identity -----------------------------------------------------------
# APP_NAME: local .env still says "Laravel" (never renamed) — set the real
# brand name here so <title> fallback / MAIL_FROM_NAME aren't left generic.
APP_NAME=ExodineWeb

# MUST be "production" — several things key off this: config/session.php's
# secure-cookie default, ForceHttps middleware, SecurityHeaders' HSTS header,
# and the admin:create command's environment guard all only activate (or
# behave safely) when this is exactly "production".
APP_ENV=production

# MUST be false. If this is ever true in production, Laravel's debug error
# pages leak stack traces, file paths, .env values, and DB queries to any
# visitor who triggers an exception. Verify this after deploy by visiting a
# URL that 404s/errors and confirming you get the branded error page, not a
# stack trace.
APP_DEBUG=false

# Leave blank here — generate a FRESH key directly on the server after first
# deploy with `php artisan key:generate`. Never reuse the local dev APP_KEY;
# it encrypts/signs sessions and cookies, a shared key across environments
# defeats that isolation.
APP_KEY=

# Real production domain, https:// scheme. Must match the actual TLS
# certificate's domain or ForceHttps redirects / secure cookies will misbehave.
APP_URL=https://yourdomain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

# --- Logging ------------------------------------------------------------
# LOG_LEVEL=debug (local default) writes verbose query/debug noise to
# storage/logs/laravel.log forever — fine locally, wasteful and slightly
# info-leaky (query params, etc.) in production. Use "error" or "warning".
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database -----------------------------------------------------------
# Fill in with the production DB credentials from your hosting control
# panel (cPanel MySQL Databases). Never the same DB as local dev.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- Session --------------------------------------------------------------
# SESSION_SECURE_COOKIE: config/session.php already defaults this to true
# whenever APP_ENV=production, so leaving it unset here is fine — but set it
# explicitly to `true` anyway for clarity/defense-in-depth. Only ever set to
# false if this specific deploy genuinely has no HTTPS (shouldn't happen —
# ForceHttps middleware assumes HTTPS is available once APP_ENV=production).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Mail -----------------------------------------------------------------
# MUST be a real transactional mailer, not "log" (local dev default — emails
# just get written to storage/logs/laravel.log and never actually sent).
# Without this, password-reset emails silently never arrive. Use whatever
# your host/provider gives you (cPanel mail account, Mailgun, SendGrid, etc.)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# --- Analytics / integrations ----------------------------------------------
# GA measurement ID is configured through the admin Settings UI (Setting
# model, "integrations" group), not an env var — nothing to set here.

VITE_APP_NAME="${APP_NAME}"
